# Scopewise API configuration. Copy to apps/api/.env for local runs (git-ignored); on Vercel set these in
# Project Settings → Environment Variables. Every variable is optional: missing ones switch features off and
# GET /health reports which features are on.

# --- Claude (scope agent, estimator panel, post-mortem, Ask) ---------------------------------------
# Without it, /scope, /panel and /ask return 503 and /postmortem returns the engine's template notes.
ANTHROPIC_API_KEY=
# Model id. Default: claude-sonnet-5-5 (current Sonnet).
ANTHROPIC_MODEL=claude-sonnet-5-5
# Server-side refusal fallbacks ("fallbacks": "default") are sent for models that support them. Set to off to disable.
ANTHROPIC_FALLBACKS=default

# --- Jira Cloud (history read + push). All four are needed. ---------------------------------------
# e.g. https://your-site.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Project key that holds the seeded history and receives pushed estimates, e.g. SCOPE
JIRA_PROJECT_KEY=

# --- Storage for lessons + Jira sync cache ---------------------------------------------------------
# Postgres connection string (e.g. Supabase). Unset → JSON file at apps/api/.data/store.json
# (on Vercel: /tmp, which does not survive cold starts).
DATABASE_URL=
# Set to "disable" for a local Postgres without TLS (default: prefer TLS).
DATABASE_SSL=
# Override the JSON store location.
STORE_PATH=

# --- HTTP -----------------------------------------------------------------------------------------
# Extra allowed origins, comma separated. http://localhost:* and https://*.github.io are always allowed.
CORS_ORIGINS=https://your-user.github.io
# Local server port (npm run dev:api).
PORT=8787
# Public URL of the web app, used for links back to the estimate in Jira descriptions.
PUBLIC_WEB_URL=https://your-user.github.io/agent-in-the-shell-estimator/
