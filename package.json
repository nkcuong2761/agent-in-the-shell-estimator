{
  "name": "scopewise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/engine",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "typecheck": "tsc -p packages/shared && tsc -p packages/engine && npm run typecheck -w apps/api && npm run typecheck -w apps/web && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --root packages/engine && vitest run --root apps/web",
    "seed": "tsx scripts/seed.ts",
    "precompute": "tsx scripts/precompute-demo.ts",
    "push-to-jira": "tsx scripts/push-to-jira.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
